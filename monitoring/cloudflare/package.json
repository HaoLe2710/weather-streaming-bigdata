{
  "name": "weather-monitoring-cloudflare-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "generate-validator": "node scripts/generate-validator.mjs",
    "validate-schema": "node scripts/generate-validator.mjs --check",
    "check-contract": "node scripts/check-contract-drift.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run validate-schema && npm run check-contract && wrangler deploy --dry-run --env=",
    "dev": "wrangler dev --env local",
    "migrate:local": "wrangler d1 migrations apply DB --local --env local",
    "sign:fixture": "node scripts/sign-snapshot.mjs",
    "generate:fixtures": "node scripts/generate-fixtures.mjs"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261012.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
